{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto para la ventana principal de BeHEVC",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-progress-bar",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
