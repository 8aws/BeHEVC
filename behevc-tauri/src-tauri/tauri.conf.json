{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "B265",
  "version": "3.2.0",
  "identifier": "com.behevc.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "B265",
        "width": 940,
        "height": 720,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "./"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    }
  }
}
